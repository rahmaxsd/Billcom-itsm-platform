# Copie ce fichier en ".env" pour changer les valeurs (le fichier .env n'est jamais poussé sur Git).
# Sans .env, docker compose utilise les valeurs par défaut du docker-compose.yml.
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=root
JWT_SECRET=change-this-secret-key-to-at-least-32-characters-long
SEED_PASSWORD=Admin123!
CORS_ORIGINS=http://localhost:4200
# Version de Java du back (doit être >= celle de ton pom.xml)
JAVA_VERSION=21
